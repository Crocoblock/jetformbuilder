/* Match the frontend image box so Image Fit works in the editor preview. */
[data-type="jet-forms/media-field"] .jet-form-builder-file-upload__file {
	width: 100px;
	height: 100px;

	img {
		display: block;
		width: 100%;
		height: 100% !important;
		max-width: none;
		padding: 0;
		margin: 0;
		object-fit: cover;
		object-position: center center;
	}
}
